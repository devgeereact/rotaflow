{
  "name": "rotaflow",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant, offline-first staff rota scheduling — build and share rotas in minutes; clock in, swap shifts and manage leave from any device.",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:migrations": "node scripts/check-migration-safety.mjs",
    "check:docs": "node scripts/check-doc-counts.mjs",
    "check:export": "node scripts/check-export-coverage.mjs",
    "og:image": "node scripts/generate-og-image.mjs",
    "load:test": "node scripts/load-test-workforce.mjs",
    "check:docs-impact": "node scripts/check-docs-impact.mjs",
    "test:php": "bash scripts/test-db.sh up && php backend/tests/run.php",
    "check:php": "for f in $(find backend -name \"*.php\" -not -path \"*/vendor/*\"); do php -l \"$f\" >/dev/null || exit 1; done && pnpm run test:php",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm check:bundle && pnpm check:migrations && pnpm check:docs && pnpm check:export && pnpm check:php",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/react": "^10.76.2",
    "@supabase/supabase-js": "^2.117.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.50.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.6.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@sentry/vite-plugin": "^5.4.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.5",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "7.4.1"
  }
}
