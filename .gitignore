# Dependencies
node_modules/
.pnpm-store/

# Local environment variables
.env
.env.local
.env.*.local

# Demo/seed account credentials — real, working logins on the live Supabase
# project (see supabase/seed/README.md). Never publish this file.
docs/ACCOUNTS.md

# Build & PWA outputs
dist/
dev-dist/
web-build/
build/
.output/
stats.html

# Cache & temp
.vite/
.expo/
.cache/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# System & editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
.idea/

# Sentry
.sentryclirc

# Design-match loop artefacts — iteration screenshots, regenerated on every run.
# `design/` was moved under `docs/` without `git mv`, which silently unignored
# 45 MB of scratch — including a Chrome user-data-dir holding Cookies and
# Login Data — in a public repo. Both paths are listed so the rename cannot
# reopen the hole.
design/.loop/
docs/design/.loop/

# Claude Code local state. `worktrees/` in particular is where agent sessions
# check out isolated copies of this repo — it was 84 MB of nested checkouts
# sitting untracked in the project root, one `git add -A` away from being
# committed into the repo it is a copy of.
.claude/worktrees/
.claude/settings.local.json
.claude/*.local.md
supabase/.temp/

# Vitest coverage output
coverage/

# Playwright local run artefacts — screenshots/traces/reports, regenerated
# every run; CI uploads its own copy as a workflow artifact instead.
test-results/
playwright-report/
blob-report/

# Ruflo/claude-flow local runtime state — daemon/swarm/metrics files churn
# every session and carry no reviewable value; regenerates automatically.
.claude-flow/
.swarm/
ruvector.db
.gstack/
.agents/

# Graphify knowledge-graph output — regenerated on every /graphify run.
graphify-out/

# Codex local tool config — machine-specific MCP endpoint, never shared
.codex/
