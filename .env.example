# ─────────────────────────────────────────────────────────────
# App
# Any var read by the browser MUST be prefixed with VITE_.
# ─────────────────────────────────────────────────────────────
VITE_APP_NAME="RotaFlow"
# Canonical public URL of YOUR deployment. Used as the auth redirect target, so
# it must match Supabase Auth -> URL Configuration (Site URL + Redirect URLs).
# Leave empty to fall back to window.location.origin (correct for local dev).
# Never point this at a domain you do not control.
VITE_APP_URL="https://rotaflow.space"

# ─────────────────────────────────────────────────────────────
# Supabase (Auth + PostgreSQL). The anon key is safe for the
# browser because access is gated by Row Level Security.
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Comma-separated OAuth providers to show on the sign-in screen, e.g.
# "google" or "google,github". Leave empty to show none.
# List a provider ONLY once it is enabled in Supabase (Authentication ->
# Providers) — otherwise the button renders but every click fails.
VITE_ENABLE_OAUTH="google,github"

# ─────────────────────────────────────────────────────────────
# ImageKit (media CDN + real-time transforms)
# ─────────────────────────────────────────────────────────────
VITE_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"
VITE_IMAGEKIT_PUBLIC_KEY="your-imagekit-public-key"

# ─────────────────────────────────────────────────────────────
# Sentry (error + performance monitoring)
# Region is FIXED at project creation and cannot be changed later —
# pick it up front. EU/DE ingest hosts look like o<org>.ingest.de.sentry.io.
# Apps handling EU/UK personal data: create in the EU region, PII scrubbing on.
# Only the browser-safe DSN belongs in this client bundle.
# ─────────────────────────────────────────────────────────────
VITE_SENTRY_DSN="https://your-dsn@sentry.io/project-id"

# ─────────────────────────────────────────────────────────────
# Inngest — RETIRED (`0087`). Deliberately absent, not forgotten.
# Notification dispatch moved into Postgres: database triggers enqueue into
# `notification_outbox` and a `pg_cron` job drains it. Nothing in this
# repository sends to Inngest, so VITE_INNGEST_EVENT_KEY / INNGEST_EVENT_KEY /
# INNGEST_SIGNING_KEY are no longer read anywhere and were removed on
# 2026-08-31. Do not re-add the VITE_ one in particular: Vite inlines every
# VITE_* variable into the bundle whether code reads it or not, so a key that
# does nothing was still being published to every visitor of a public site.
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# RotaFlow — Web Push (VAPID)
# The PUBLIC key is browser-safe (used to subscribe the device).
# The PRIVATE key signs pushes and lives ONLY in a Supabase Edge Function.
# ─────────────────────────────────────────────────────────────
VITE_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"          # server-only (Edge Function)
VAPID_SUBJECT="mailto:admin@gakinz.com"           # server-only

# ─────────────────────────────────────────────────────────────
# RotaFlow — AI rota assistant (OpenRouter, via the ai-rota-assistant
# Supabase Edge Function). This var documents the key for local reference
# only — the Edge Function reads it from a Supabase project secret, not
# from this file. Set it with:
#   supabase secrets set OPENROUTER_API_KEY=... --project-ref <ref>
# or via the Supabase dashboard: Project Settings → Edge Functions → Secrets.
#
# The SAME variable name is ALSO required as a GitHub Actions secret, in a
# different store, for the weekly plan-drift audit
# (.github/workflows/plan-drift-audit.yml, which runs scripts/plan-drift-audit.mjs).
# Setting the Supabase secret above does NOT set the Actions one:
#   gh secret set OPENROUTER_API_KEY
# The model can be overridden there with an Actions *variable* rather than a
# secret, since it is not sensitive:
#   gh variable set OPENROUTER_MODEL --body openai/gpt-4o-mini
# If the Actions secret is missing the audit does not fail quietly: it writes a
# dated FAILED entry into the plan doc and turns the workflow run red.
# ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY="your-openrouter-api-key"        # server-only (Edge Function)
OPENROUTER_MODEL="openai/gpt-4o-mini"               # server-only, optional override
# Sent to OpenRouter as HTTP-Referer for request attribution. Optional — the
# function falls back to https://rotaflow.space — but set it on any project
# that is not that site, or the attribution is simply wrong.
APP_URL="https://rotaflow.space"                   # server-only, optional

# ─────────────────────────────────────────────────────────────
# RotaFlow — notification shared secret. DO NOT SET THIS ANYWHERE.
# It proves a call to `send-notification` came from this project's own outbox
# drain; neither side has an end-user JWT, so it is the only thing standing
# between the notification pipeline and anyone who finds the URL.
#
# Migration `0091` generates it inside Postgres with `gen_random_bytes` and
# stores it in `vault` alone. Both sides read it from there — the drain to
# send it, `verify_notification_secret()` to check it — so no human ever
# handles the value and there is no second copy to keep in step.
#
# This entry used to read `supabase secrets set NOTIFICATION_FUNCTION_SECRET=…`,
# which required the same value in two places, neither readable back. For a
# month the two disagreed and the queue delivered nothing while looking
# healthy. Setting an env var of this name today does nothing — the function
# stopped reading it when v26 deployed on 2026-08-31 — but writing the value
# down anywhere is the start of the same drift, so there is no line to copy.
# Rotate by deleting the `vault` row and re-running `0091`'s DO block.
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# RotaFlow — Email via SMTP (server-only; sent from a Supabase Edge Function).
# No third-party email provider — plain SMTP. Never expose these to the browser.
# ─────────────────────────────────────────────────────────────
SMTP_HOST="smtp.yourhost.com"
SMTP_PORT="587"
SMTP_USER="notifications@gakinz.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="RotaFlow <notifications@gakinz.com>"

# ─────────────────────────────────────────────────────────────
# RotaFlow — SMS (RESERVED, NOT USED IN V1). Seam kept for later; do not wire up.
# ─────────────────────────────────────────────────────────────
# SMS_PROVIDER=""            # e.g. twilio — later
# SMS_ACCOUNT_SID=""         # server-only — later
# SMS_AUTH_TOKEN=""          # server-only — later

# ─────────────────────────────────────────────────────────────
# RotaFlow — Payments (Stripe). SHIPPED — migration 0050 plus the
# create-checkout-session, create-portal-session and stripe-webhook
# Edge Functions.
#
# Checkout and the customer portal are hosted entirely by Stripe. There is
# no Stripe.js in the browser bundle, so THERE IS NO CLIENT-SIDE STRIPE
# VARIABLE — nothing in src/ reads VITE_STRIPE_PUBLISHABLE_KEY. Do not add
# one expecting it to take effect.
#
# Every value below is server-only and is NOT read from this file: the Edge
# Functions read them from Supabase project secrets. This file documents the
# names so both modes can be recorded in one place.
#
#   supabase secrets set STRIPE_MODE=test --project-ref <ref>
#   supabase secrets set STRIPE_SECRET_KEY=sk_live_... --project-ref <ref>
#   supabase secrets set STRIPE_TEST_SECRET_KEY=sk_test_... --project-ref <ref>
#   supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_... --project-ref <ref>
#   supabase secrets set STRIPE_TEST_WEBHOOK_SECRET=whsec_... --project-ref <ref>
#
# Both modes' credentials can be set at once. STRIPE_MODE alone decides which
# pair create-checkout-session and create-portal-session use, so switching to
# test mode for QA and back to live afterwards is a one-secret change and
# never overwrites the live key. The webhook ignores STRIPE_MODE entirely —
# see STRIPE_TEST_WEBHOOK_SECRET below.
# ─────────────────────────────────────────────────────────────

# Which mode Checkout and the Customer Portal run in: "test" or "live".
# UNSET DEFAULTS TO LIVE, so an existing deployment that never sets this keeps
# behaving exactly as before. Set it to "test" only on a deployment where real
# customers cannot reach billing.
STRIPE_MODE="live"                                  # server-only — test | live

# ── LIVE credentials ────────────────────────────────────────
# Stripe Dashboard with the Test mode toggle OFF.
# Developers → API keys → Secret key.
STRIPE_SECRET_KEY="sk_live_your-live-secret-key"    # server-only (Edge Function)

# Developers → Webhooks → your endpoint → Signing secret, in LIVE mode.
STRIPE_WEBHOOK_SECRET="whsec_your-live-signing-secret"        # server-only

# ── TEST credentials ────────────────────────────────────────
# The same two screens with the Test mode toggle ON. These are different
# objects in a different Stripe namespace, not alternative spellings of the
# live ones — a test key can never charge a real card.
STRIPE_TEST_SECRET_KEY="sk_test_your-test-secret-key"         # server-only

# The signing secret for the SAME function URL registered as a webhook
# endpoint in Stripe's TEST mode, or the whsec_ printed by:
#   stripe listen --forward-to https://<ref>.supabase.co/functions/v1/stripe-webhook
# The webhook function does not consult STRIPE_MODE: every Stripe event
# carries a `livemode` flag, so it verifies each event against whichever of
# the two secrets matches that event's own mode. Register the endpoint in both
# Stripe modes and both sets of events keep working simultaneously.
STRIPE_TEST_WEBHOOK_SECRET="whsec_your-test-signing-secret"   # server-only

# ── Price IDs are NOT environment variables ─────────────────
# Each plan's Stripe Price lives in the `plans` table: `stripe_price_id` for
# live, `stripe_test_price_id` for test (migration 0058). Test and live prices
# are separate objects with different IDs, which is exactly why they get their
# own column — pointing one column at the other mode's price is the
# "No such price" failure, and overwriting the live column to run a test is
# how a live checkout silently breaks.
#
# After creating the four products in Stripe's TEST mode, backfill:
#   update public.plans set stripe_test_price_id = 'price_...' where code = 'starter';
#   update public.plans set stripe_test_price_id = 'price_...' where code = 'professional';
#   update public.plans set stripe_test_price_id = 'price_...' where code = 'business';
#   update public.plans set stripe_test_price_id = 'price_...' where code = 'enterprise';
