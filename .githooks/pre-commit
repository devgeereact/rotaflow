#!/usr/bin/env bash
# Blocks commits that contain secrets. Enabled automatically by `pnpm install` (see "prepare").
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (macOS: brew install gitleaks). Commit blocked." >&2
  exit 1
fi

gitleaks git --pre-commit --redact --staged --no-banner
