# =============================================================
#  cPanel / Apache config for a static Vite SPA (PWA)
#  Upload alongside the contents of /dist into public_html.
# =============================================================

# ---- Force HTTPS + SPA routing --------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect all HTTP traffic to HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Never serve source maps. vite.config.ts uses `sourcemap: 'hidden'` so nothing
  # links to them and the deploy excludes *.map — this is the last line of
  # defence for a map copied up by hand or by a future CI step. A .map
  # de-minifies to the full original TypeScript of a multi-tenant app holding
  # staff PII; it belongs in Sentry, not on the public web.
  #
  # Done with mod_rewrite rather than <FilesMatch>/Require: this block is already
  # proven to load on this host, whereas a Require directive on a server without
  # mod_authz_core 500s the entire site.
  RewriteRule \.map$ - [F,L]

  # Build output is REAL FILES. If one is missing that is a broken deploy, and
  # it has to look like one — so these paths are excluded from the SPA fallback
  # below and are allowed to 404 honestly.
  #
  # Without this, the fallback swallowed every miss: a request for
  # /assets/index-abc123.js that did not exist returned index.html with
  # `content-type: text/html` and **HTTP 200**. Consequences, all real:
  #
  #   * It defeats verification. Uptime monitors, link checkers, CI steps
  #     asserting an asset deployed, and any agent checking its own deploy all
  #     read 200 as "present". This audit was itself fooled into reporting a
  #     source-map leak that did not exist (docs/audit01.md §2, P1-7).
  #   * It is the exact failure vite.config.ts warns about under `base: '/'` —
  #     a script request answered with HTML, failing the MIME check, leaving a
  #     blank page with a 200 in the access log and nothing in Sentry.
  #
  # Scoped deliberately to the two directories the build emits. Everything else
  # still falls through, so SPA deep links are untouched.
  RewriteRule ^(assets|icons)/ - [L]

  # Send every non-file, non-directory request to index.html
  # so React Router can resolve client-side routes.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# ---- Correct MIME types for PWA assets ------------------------
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/json .json
  AddType text/javascript .js .mjs
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

# ---- Compression ----------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript \
    application/javascript application/json image/svg+xml \
    application/manifest+json
</IfModule>

# ---- Caching --------------------------------------------------
<IfModule mod_headers.c>
  # Hashed build assets can be cached forever.
  <FilesMatch "\.(js|mjs|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # NEVER cache the service worker, manifest, or the HTML entrypoint,
  # otherwise users get stuck on stale app versions.
  <FilesMatch "(sw\.js|service-worker\.js|workbox-.*\.js|manifest\.webmanifest|index\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Baseline security headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # HSTS. Safe here because rota.gakinz.com is HTTPS-only behind Cloudflare and
  # the RewriteRule above already 301s any plaintext request. No `preload` and no
  # includeSubDomains: gakinz.com has sibling hosts this deploy does not own, and
  # preload is effectively irreversible.
  Header always set Strict-Transport-Security "max-age=31536000"

  # Deny hardware/API surface the app never uses. Geolocation is NOT in this list
  # — /app/clock reads GPS for clock-in, so revoking it would break attendance.
  Header set Permissions-Policy "camera=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=()"
</IfModule>

# ---- Pretty error handling ------------------------------------
# Kept, but note it is now nearly dead code: the SPA fallback above already
# resolves every unknown NON-file path to index.html with a 200, so the only
# thing that reaches here is a miss under assets/ or icons/.
#
# For those it serves the app shell as the *body* of a 404. That is deliberate:
# the status line is what matters (it is what makes a broken deploy detectable),
# and a browser fetching a missing chunk sees 404 and fails correctly regardless
# of the body. Do NOT "fix" this by removing the exclusion above — that trades a
# cosmetic oddity for an undetectable outage.
ErrorDocument 404 /index.html
