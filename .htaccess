# =============================================================
#  cPanel / Apache config for a static Vite SPA (PWA)
#  Upload alongside the contents of /dist into public_html.
# =============================================================

# ---- Force HTTPS + SPA routing --------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect all HTTP traffic to HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Never serve source maps. vite.config.ts uses `sourcemap: 'hidden'` so nothing
  # links to them and the deploy excludes *.map — this is the last line of
  # defence for a map copied up by hand or by a future CI step. A .map
  # de-minifies to the full original TypeScript of a multi-tenant app holding
  # staff PII; it belongs in Sentry, not on the public web.
  #
  # Done with mod_rewrite rather than <FilesMatch>/Require: this block is already
  # proven to load on this host, whereas a Require directive on a server without
  # mod_authz_core 500s the entire site.
  RewriteRule \.map$ - [F,L]

  # ---- /api: the PHP API (2026-10-30, S9) ------------------------------------
  # The deploy puts backend/public/api/index.php at api/index.php; its code and
  # config live outside the webroot. Every /api path goes to that one file, so
  # an API URL can never fall into the SPA fallback (a 200 HTML page where JSON
  # was expected) or the 404 page. The bearer token is passed through: Apache
  # under cPanel does not hand Authorization to PHP otherwise.
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteCond %{REQUEST_URI} !^/api/index\.php$
  RewriteRule ^api(/.*)?$ api/index.php [L,QSA]

  # Build output is REAL FILES. If one is missing that is a broken deploy, and
  # it has to look like one — so these paths are excluded from the SPA fallback
  # below and are allowed to 404 honestly.
  #
  # Without this, the fallback swallowed every miss: a request for
  # /assets/index-abc123.js that did not exist returned index.html with
  # `content-type: text/html` and **HTTP 200**. Consequences, all real:
  #
  #   * It defeats verification. Uptime monitors, link checkers, CI steps
  #     asserting an asset deployed, and any agent checking its own deploy all
  #     read 200 as "present". This audit was itself fooled into reporting a
  #     source-map leak that did not exist (`docs/SAAS.md`).
  #   * It is the exact failure vite.config.ts warns about under `base: '/'` —
  #     a script request answered with HTML, failing the MIME check, leaving a
  #     blank page with a 200 in the access log and nothing in Sentry.
  #
  # Scoped deliberately to the two directories the build emits. Everything else
  # still falls through, so SPA deep links are untouched.
  RewriteRule ^(assets|icons)/ - [L]

  # ---- Prerendered public pages and a real 404 (2026-10-22) ----
  #
  # Until this block every unknown path fell through to index.html with a 200,
  # so a crawler could not tell a dead URL from a live one and the 404 page had
  # to say `noindex` itself. Now, in this order:
  #
  #   1. `/` serves the prerendered home page (scripts/prerender.mjs).
  #   2. Real files and directories are served as they are: the bundle,
  #      sitemap.xml, robots.txt, /.well-known/ and dist/prerendered/ itself.
  #   3. A public page with a prerendered copy serves it, so crawlers and
  #      visitors without JavaScript get the page and not an empty <div>.
  #   4. A path whose first segment is a route in src/App.tsx falls back to
  #      index.html, so React Router resolves it. The list is checked against
  #      the route table by src/lib/htaccessRoutes.test.ts, which fails if a
  #      route is added without it (that route would 404) or an entry outlives
  #      its route.
  #   5. Anything else is a real 404, with the prerendered not-found page as
  #      its body (ErrorDocument at the end of this file).
  #
  # If dist/prerendered/ is missing, steps 1 and 3 find no file and the public
  # pages fall back to index.html through step 4, as before. Nothing goes dark.
  # An installed client never sees any of this for navigation: its service
  # worker answers from the precached app shell.
  RewriteRule ^$ prerendered/index.html [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteCond %{DOCUMENT_ROOT}/prerendered/$1.html -f
  RewriteRule ^(.+?)/?$ prerendered/$1.html [L]

  # app-routes: kept in step with src/App.tsx by src/lib/htaccessRoutes.test.ts
  RewriteRule ^(about|admin|app|auth|contact|features|forgot-password|invite|legal|login|onboarding|pricing|reset-password|resources|signup|solutions|splash)(/.*)?$ index.html [L]

  RewriteRule ^ - [R=404,L]
</IfModule>

# ---- Correct MIME types for PWA assets ------------------------
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/json .json
  AddType text/javascript .js .mjs
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

# No server version on Apache-generated error pages (ServerTokens cannot be set
# in .htaccess; Cloudflare replaces the Server header in every response).
ServerSignature Off

# ---- Compression ----------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript \
    application/javascript application/json image/svg+xml \
    application/manifest+json
</IfModule>

# ---- Caching --------------------------------------------------
<IfModule mod_headers.c>
  # Hashed build assets can be cached forever.
  <FilesMatch "\.(js|mjs|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # NEVER cache the service worker, manifest, or any HTML page, otherwise
  # users get stuck on stale app versions. Every `.html`, not only index.html:
  # the prerendered pages under prerendered/ name this build's hashed assets
  # too, and a cached copy would ask for files the next deploy deleted.
  <FilesMatch "(sw\.js|service-worker\.js|push-sw\.js|workbox-.*\.js|manifest\.webmanifest|\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Baseline security headers
  # No software or version banners (security audit, 1 Nov 2026). The origin's
  # Server header is already replaced by Cloudflare; `X-Powered-By` (PHP) and
  # LiteSpeed's `X-Turbo-Charged-By` are dropped here. `always` also covers
  # error responses. backend/public/api/index.php removes X-Powered-By too.
  Header always unset X-Powered-By
  Header unset X-Powered-By
  Header always unset X-Turbo-Charged-By
  Header unset X-Turbo-Charged-By
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # HSTS. Safe here because rotaflow.space is HTTPS-only behind Cloudflare and
  # the RewriteRule above already 301s any plaintext request. No `preload` and no
  # includeSubDomains: RotaFlow now owns the whole rotaflow.space apex (it was a
  # subdomain of gakinz.com until 2026-08-29, sharing the parent with hosts this
  # deploy does not own), so the original reason to omit it is gone. Still
  # omitted deliberately: it would bind every future rotaflow.space hostname to
  # HTTPS for a year, including ones not created yet. `preload` stays off for
  # the stronger version of the same reason — it is effectively irreversible.
  Header always set Strict-Transport-Security "max-age=31536000"

  # Deny hardware/API surface the app never uses. Geolocation is NOT in this list
  # — /app/clock reads GPS for clock-in, so revoking it would break attendance.
  Header set Permissions-Policy "camera=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=()"

  # ---- Content-Security-Policy --------------------------------
  # Every origin below was derived from the code and then VERIFIED by serving
  # the real production build behind this exact policy and driving a headless
  # browser over it. Two things only that testing could have found:
  #
  #   1. worker-src needs `blob:`. Sentry's replayIntegration compresses
  #      payloads in a Worker created from a blob URL. Without it, every route
  #      logs a CSP violation.
  #
  #   2. connect-src needs the Google Fonts origins, even though the fonts are
  #      a STYLESHEET and style-src already allows them. On the first visit the
  #      page fetches the stylesheet directly and style-src governs it. On every
  #      visit after that the service worker's StaleWhileRevalidate handler
  #      fetches it, and a fetch() is governed by connect-src. Miss this and
  #      fonts break on the second load and every load after — never the first,
  #      which is exactly the shape of bug nobody reproduces.
  #
  # 'unsafe-inline' in style-src is required: framer-motion and React write
  # inline styles. It is NOT in script-src, which is where it would matter —
  # index.html carries no inline script.
  #
  # img-src allows any https: on purpose. Older staff photos are pasted
  # https URLs (`docs/SAAS.md`), so locking this down would break real
  # avatars. Images cannot execute; the job here is stopping script
  # injection, not policing image hosts. Tighten it when uploads land.
  #
  # openrouter.ai is deliberately absent — the AI key never reaches the browser;
  # only the API's AI assistant route talks to it.
  #
  # fonts.googleapis.com and fonts.gstatic.com were removed on 2026-09-03,
  # from style-src, font-src AND connect-src. The webfonts are served from this
  # origin now (public/fonts/, src/index.css), which was a privacy fix rather
  # than a performance one: /legal/cookies says in bold that no third-party
  # script runs on this site, and every page was sending each visitor's IP and
  # User-Agent to Google before they had interacted with anything. Same
  # reasoning as inn.gs below — an entry for a host the app no longer contacts
  # is permission granted to whatever else might try to reach it.
  #
  # The connect-src half mattered as much as the others: the service worker's
  # fetch of a font is governed by connect-src, not font-src, which is why both
  # origins appeared twice. Self-hosting makes 'self' cover it.
  #
  # inn.gs was removed on 2026-08-31. It was allowed so the browser could post
  # events to Inngest; `0087` moved every dispatch into the database and nothing
  # has connected to that host since. A connect-src entry for a service the app
  # no longer calls is permission granted to whatever else might try — this is
  # the same clean-up as deleting the event key, one layer up.
  #
  # ⚠️ This file is NOT what the live site serves on its own. The server's copy
  # is this file with the Cloudflare origin-lock block PREPENDED, and a deploy
  # only replaces it through `pnpm htaccess push`
  # (docs/DEPLOYMENT.md). Deploying this file bare would drop that block and
  # reopen the origin. The composed deploy of 2026-08-31 carried this change
  # through: the live CSP no longer names inn.gs, and direct-to-origin still
  # returns 403.
  # Clerk (2026-10-30, S9): its script and API are served from the frontend
  # API host clerk.rotaflow.space; cdn.protect.clerk.com and Cloudflare's
  # challenge (script and frame) are its bot protection on sign-up;
  # clerk-telemetry.com takes its SDK telemetry; avatars come from img.clerk.com,
  # which img-src https: already allows. The Supabase and ImageKit origins are
  # gone: the app talks only to its own /api now.
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' https://clerk.rotaflow.space https://cdn.protect.clerk.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' https://clerk.rotaflow.space https://clerk-telemetry.com https://o4511713747271680.ingest.de.sentry.io; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'"
</IfModule>

# ---- Pretty error handling ------------------------------------
# Two things reach here: a path that is neither a file nor a route (the
# `R=404` rule above), and a miss under assets/ or icons/. Both get the
# prerendered not-found page as the body of a real 404. Before 2026-10-22 the
# body was index.html, and an unknown path never got here at all: the SPA
# fallback answered it with a 200.
#
# The status line is what matters for a missing chunk (it is what makes a
# broken deploy detectable), and a browser fetching one sees 404 and fails
# correctly regardless of the body. Do NOT "fix" anything by removing the
# assets/icons exclusion above: that trades a cosmetic oddity for an
# undetectable outage. If dist/prerendered/404.html is absent, Apache falls
# back to its own plain 404 page, still with the right status.
ErrorDocument 404 /prerendered/404.html
